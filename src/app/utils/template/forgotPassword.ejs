<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Forgot Password</title>
  <style>
    /* Basic reset */
    body { margin:0; font-family: Inter, 'Helvetica Neue', Arial, sans-serif; background:#f8fbff; color:#1f2d3d; }
    .container { max-width:600px; margin:40px auto; background:#fff; border-radius:10px; overflow:hidden; box-shadow:0 6px 20px rgba(17,24,39,0.08);}
    .top { padding:36px 40px; text-align:center; }
    .logo { width:72px; height:72px; margin:0 auto 18px; display:block; }
    h1 { margin:0 0 8px; font-size:20px; color:#073b66; }
    p.lead { margin:0 0 18px; color:#4b5563; font-size:14px; }
    .card { background:#e6f2ff; border-radius:8px; padding:22px; margin:12px 40px; text-align:center; }
    .code { font-size:28px; color: #fff; letter-spacing:3px; font-weight:700; color:#123a6e; }
    .muted { font-size:13px; color:#6b7280; margin-top:8px; }
    .body-text { padding:0 40px 30px 40px; font-size:13px; color:#374151; line-height:1.5; }
    .btn-wrap { text-align:center; padding-bottom:22px; }
    .btn { display:inline-block; text-decoration:none; padding:10px 22px; border-radius:8px; background:#1181e6; color:#fff; font-weight:600; }
    .footer { background:#07224a; color:#fff; padding:20px 40px; text-align:center; }
    .brand { font-size:18px; font-weight:700; margin-top:8px; display:flex; gap:8px; align-items:center; justify-content:center; }
    .small-links { margin-top:10px; font-size:12px; opacity:0.85; }
    @media (max-width:640px){
      .container { margin:20px; }
      .card { margin:12px; }
      .top, .body-text, .footer { padding-left:18px; padding-right:18px; }
    }
  </style>
</head>
<body>
  <div class="container" role="article" aria-label="Two factor authentication email">
    <div class="top">
      <!-- Logo: using provided local file path. Convert to URL when serving. -->
      <img src="https://nagad.com.bd/_nuxt/img/new-logo.14fe8a5.png" alt="lock logo" class="logo" />
      <h1>Secure Your Account with Two-Factor Authentication</h1>
      <p class="lead">Hello <strong><%= name %></strong>,</p>
      <p class="lead" style="font-weight:400">To enhance the security of your account, we require two-factor authentication for access. Here is your 2FA code:</p>
    </div>

    <div class="card" role="region" aria-label="2FA code card">
      <a href="<%= resetUILink %>" class="code">SET PASSWORD</a>
    </div>

    <div class="body-text">
      <p>Please enter this code in the login prompt to access your account. If you did not request this code or are not trying to access your account, please contact us immediately for support.</p>
      <p>For additional security, consider updating your password and reviewing your account settings regularly.</p>
    </div>

    <div class="btn-wrap">
      <a class="btn" href="#">Visit your account</a>
    </div>

    <div class="footer">
      <div class="brand">
        <!-- small icon (optional) -->
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M12 2L3 7v6c0 5 5 9 9 9s9-4 9-9V7l-9-5z" fill="#60a5fa"/>
        </svg>
        <span>Fin Flow</span>
      </div>
      <div class="small-links">Privacy Policy &nbsp; • &nbsp; Contact Us &nbsp; • &nbsp; Unsubscribe</div>
    </div>
  </div>
</body>
</html>
